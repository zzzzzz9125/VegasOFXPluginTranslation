<?xml version="1.0" encoding="utf-8"?>
<OfxImageEffectResource>
  <OfxPlugin name="net.alestemple.AdvancedGIFManager">
    <OfxResourceSet ofxHost="default">
      <OfxPropLabel>高级GIF管理器</OfxPropLabel>
      <OfxImageEffectPluginPropGrouping>实用工具</OfxImageEffectPluginPropGrouping>
      <OfxPropPluginDescription>高级GIF管理器 — 强大的工具，由alestemple.net提供
作者：Alessander Demyanov</OfxPropPluginDescription>
      <OfxImageEffectContext name="default">
        <OfxParamTypeBoolean name="exportGif">
          <OfxPropLabel>&gt;&gt; 导出 GIF &lt;&lt;</OfxPropLabel>
          <OfxParamPropHint>开启以生成GIF文件。关闭以重置。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="browseSaveAs">
          <OfxPropLabel>浏览保存为...</OfxPropLabel>
          <OfxParamPropHint>打开“另存为”对话框以选择输出文件。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeString name="outputPath">
          <OfxPropLabel>输出路径</OfxPropLabel>
          <OfxParamPropHint>GIF文件的完整路径（使用“浏览保存为”选择）</OfxParamPropHint>
        </OfxParamTypeString>
        <OfxParamTypeChoice name="preset">
          <OfxPropLabel>预设</OfxPropLabel>
          <OfxParamPropHint>带有尺寸/帧率限制的社交媒体预设。</OfxParamPropHint>
          <OfxParamPropChoiceOption>无</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>Twitter（15MB，512像素）</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>Discord（10MB，400像素）</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>Telegram（5MB，320像素）</OfxParamPropChoiceOption>
        </OfxParamTypeChoice>
        <OfxParamTypeBoolean name="openFolder">
          <OfxPropLabel>导出后打开文件夹</OfxPropLabel>
          <OfxParamPropHint>GIF保存后在资源管理器中打开输出文件夹。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeDouble name="gifWidth">
          <OfxPropLabel>宽度（像素）</OfxPropLabel>
          <OfxParamPropHint>GIF输出宽度。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="gifHeight">
          <OfxPropLabel>高度（像素）</OfxPropLabel>
          <OfxParamPropHint>GIF输出高度。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeBoolean name="lockAspect">
          <OfxPropLabel>锁定纵横比</OfxPropLabel>
          <OfxParamPropHint>保持源纵横比（调整高度）。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="pixelArt">
          <OfxPropLabel>像素艺术模式</OfxPropLabel>
          <OfxParamPropHint>使用最近邻缩放代替双线性。像素清晰。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="autoCrop">
          <OfxPropLabel>自动裁剪</OfxPropLabel>
          <OfxParamPropHint>检测并裁剪静态边框以减小文件大小。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeDouble name="gifFPS">
          <OfxPropLabel>GIF帧率</OfxPropLabel>
          <OfxParamPropHint>输出GIF的帧率。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="maxFrames">
          <OfxPropLabel>最大帧数</OfxPropLabel>
          <OfxParamPropHint>GIF中的最大帧数。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="maxDuration">
          <OfxPropLabel>最大时长（秒）</OfxPropLabel>
          <OfxParamPropHint>GIF最大时长。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeChoice name="loopMode">
          <OfxPropLabel>循环模式</OfxPropLabel>
          <OfxParamPropHint>GIF的循环方式。</OfxParamPropHint>
          <OfxParamPropChoiceOption>不循环</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>无限循环</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>指定次数</OfxParamPropChoiceOption>
        </OfxParamTypeChoice>
        <OfxParamTypeDouble name="loopCount">
          <OfxPropLabel>循环次数</OfxPropLabel>
          <OfxParamPropHint>循环次数（用于“指定次数”模式）。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeBoolean name="pingPong">
          <OfxPropLabel>往返循环</OfxPropLabel>
          <OfxParamPropHint>正向+反向回旋镖式循环。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="reverse">
          <OfxPropLabel>反向</OfxPropLabel>
          <OfxParamPropHint>反向播放帧。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeChoice name="maxColors">
          <OfxPropLabel>最大颜色数</OfxPropLabel>
          <OfxParamPropHint>调色板大小。</OfxParamPropHint>
          <OfxParamPropChoiceOption>4</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>8</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>16</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>32</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>64</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>128</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>256</OfxParamPropChoiceOption>
        </OfxParamTypeChoice>
        <OfxParamTypeChoice name="ditherMode">
          <OfxPropLabel>抖动模式</OfxPropLabel>
          <OfxParamPropHint>颜色抖动方法。</OfxParamPropHint>
          <OfxParamPropChoiceOption>无</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>弗洛伊德-斯坦伯格抖动</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>有序抖动（Bayer）</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>时间抖动（动态抖动）</OfxParamPropChoiceOption>
        </OfxParamTypeChoice>
        <OfxParamTypeDouble name="ditherStrength">
          <OfxPropLabel>抖动强度</OfxPropLabel>
          <OfxParamPropHint>抖动强度。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeBoolean name="perFramePalette">
          <OfxPropLabel>逐帧调色板</OfxPropLabel>
          <OfxParamPropHint>为每帧构建最佳调色板。质量更好，文件更大。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="frameDelta">
          <OfxPropLabel>帧间差异优化</OfxPropLabel>
          <OfxParamPropHint>仅编码变化的像素。文件缩小30-60%。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeBoolean name="transparencyEn">
          <OfxPropLabel>透明度</OfxPropLabel>
          <OfxParamPropHint>为alpha低于阈值的像素启用GIF透明度。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeDouble name="transpThreshold">
          <OfxPropLabel>Alpha阈值</OfxPropLabel>
          <OfxParamPropHint>alpha低于此值的像素变为透明。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="matteR">
          <OfxPropLabel>蒙版红色</OfxPropLabel>
          <OfxParamPropHint>Alpha蒙版背景红色通道。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="matteG">
          <OfxPropLabel>蒙版绿色</OfxPropLabel>
          <OfxParamPropHint>Alpha蒙版背景绿色通道。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="matteB">
          <OfxPropLabel>蒙版蓝色</OfxPropLabel>
          <OfxParamPropHint>Alpha蒙版背景蓝色通道。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeDouble name="speed">
          <OfxPropLabel>速度</OfxPropLabel>
          <OfxParamPropHint>播放速度倍数。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeChoice name="easeMode">
          <OfxPropLabel>缓动模式</OfxPropLabel>
          <OfxParamPropHint>帧延迟曲线。</OfxParamPropHint>
          <OfxParamPropChoiceOption>线性</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>缓入</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>缓出</OfxParamPropChoiceOption>
          <OfxParamPropChoiceOption>缓入缓出</OfxParamPropChoiceOption>
        </OfxParamTypeChoice>
        <OfxParamTypeBoolean name="crossfadeEn">
          <OfxPropLabel>交叉淡变循环</OfxPropLabel>
          <OfxParamPropHint>将最后几帧与第一帧混合以实现无缝循环。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeDouble name="crossfadeFrames">
          <OfxPropLabel>交叉淡变帧数</OfxPropLabel>
          <OfxParamPropHint>混合的帧数。</OfxParamPropHint>
        </OfxParamTypeDouble>
        <OfxParamTypeBoolean name="targetSizeEn">
          <OfxPropLabel>目标文件大小</OfxPropLabel>
          <OfxParamPropHint>自动优化以符合目标KB。可能会减少颜色/尺寸。</OfxParamPropHint>
        </OfxParamTypeBoolean>
        <OfxParamTypeDouble name="targetSizeKB">
          <OfxPropLabel>目标大小（KB）</OfxPropLabel>
          <OfxParamPropHint>GIF文件的最大大小（千字节）。</OfxParamPropHint>
        </OfxParamTypeDouble>
      </OfxImageEffectContext>
    </OfxResourceSet>
  </OfxPlugin>
</OfxImageEffectResource>